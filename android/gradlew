#!/bin/sh
#
# Gradle start script for FreeX TV (Android). Starts the Gradle wrapper, which downloads the
# Gradle version in gradle/wrapper/gradle-wrapper.properties on first use.
#
APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
    [ -x "$JAVACMD" ] || { echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2; exit 1; }
else
    JAVACMD=java
    command -v java >/dev/null 2>&1 || { echo "ERROR: JAVA_HOME is not set and no 'java' command could be found." >&2; exit 1; }
fi
exec "$JAVACMD" -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=gradlew" \
    -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
